# Copiez ce fichier en `.env` (ou remplissez ces variables dans Plesk, rubrique Node.js).

# Adresse publique du site, sans https:// (ex. cobblemonshowdown.fr)
SITE_HOST=localhost

# Base de données MySQL/MariaDB (à créer dans Plesk, rubrique Bases de données)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cobblemon
DB_USER=cobblemon
DB_PASSWORD=

# Pseudos administrateurs du site, séparés par des virgules (Bliinnd si absent).
# Chaque pseudo reçoit le rang Administrateur (~) au premier redémarrage après son inscription.
ADMINS=Bliinnd

# Ports internes (à changer seulement s'ils sont déjà pris sur le serveur)
SIM_PORT=8000
LOGIN_PORT=9000

# Développement local uniquement : HTTPS avec un certificat auto-signé
# DEV_HTTPS=1
# PORT=443
